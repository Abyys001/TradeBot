# Production image: build the Nuxt bundle, then run the nitro server directly.
# No dev server, no bind mount, no host node_modules.
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Nothing about the WebSocket is baked in here. nitro cannot proxy an upgrade
# (see nuxt.config.ts), so Caddy routes /ws straight to Channels and the panel
# derives a same-origin wss:// URL at runtime. NUXT_PUBLIC_WS_BASE stays unset
# rather than baking a hostname into the bundle.
ENV NODE_ENV=production
RUN npm run build

FROM node:22-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
COPY --from=build /app/.output .output

EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
