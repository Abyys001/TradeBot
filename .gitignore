# --- Python ---
__pycache__/
*.py[cod]
.venv/
backend/.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node ---
node_modules/
.output/
.nuxt/
dist/
.docusaurus/

# --- Env & secrets (NEVER commit — this repo handles live API keys) ---
.env
.env.*
!.env.example
!.env.production.example
# VPS connection details (host, user, password/key path). Covered by
# `.env.*` above, named again because this one holds a login to a server
# that runs live trading — an accidental `git add -f` is the only way it
# leaves this machine, and it should be loud when it does.
.env.vps
!.env.vps.example
*.pem
*.key
secrets/

# --- Data / runtime ---
db.sqlite3
*.log
media/
staticfiles/
# run.sh's process ids and log files. Never commit: they are machine-local, and
# a server log is the last place you want mirrored to a public remote on a
# platform that handles live trading credentials.
.run/
# Browser-automation scratch output (console dumps, screenshots).
.playwright-mcp/

# --- Vendored reference material build artifacts ---
reference/**/node_modules/
reference/**/build/
reference/**/.docusaurus/

# --- Editors / OS ---
.idea/
.vscode/
.DS_Store

# --- Knowledge-graph output (generated by the graphify skill, 14M of derived
# artifacts — regenerate it, never mirror it). ---
graphify-out/
