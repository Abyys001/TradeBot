# PRODUCTION template. Copy to .env on the VPS and fill the `change-me` values:
#   cp .env.production.example .env
# .env is gitignored and must never be committed — this stack holds live,
# trade-enabled exchange credentials.
#
# Launch (see docs/deploy.md):
#   docker compose -f docker-compose.prod.yml up -d --build
#
# The domain must resolve to this server (A/AAAA record) before the stack
# starts: Caddy provisions the TLS certificate from Let's Encrypt at boot.

# --- Site -----------------------------------------------------------------
# Caddy terminates TLS for this domain. Everything public derives from it.
SITE_DOMAIN=maxbot.cybercina.co.uk

# --- Django ---------------------------------------------------------------
# Must be false in production. true disables every HTTPS hardening setting.
DJANGO_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
# The panel forwards the browser's Host as X-Forwarded-Host, so the public
# domain MUST be listed here or Django answers 400 DisallowedHost.
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1,maxbot.cybercina.co.uk
# Off: TLS is terminated by the proxy in front (Caddy/nginx) and forwarded as
# X-Forwarded-Proto: https, so Django never sees plaintext HTTP from browsers.
# Left true (the DEBUG=false default), the compose healthcheck — which probes
# http://127.0.0.1:8000 on the docker network, with no forwarder header — gets
# a 301 instead of 200 and the backend never turns healthy.
DJANGO_SECURE_SSL_REDIRECT=false
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# PostgreSQL, always — there is no USE_SQLITE flag any more, so a dev .env
# pasted here can no longer put a live deployment on a SQLite file.
#
# DATABASE_URL wins when set, for a managed Postgres outside this stack:
# DATABASE_URL=postgres://user:password@host:5432/walletmanager
POSTGRES_DB=walletmanager
POSTGRES_USER=walletmanager
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# --- Credential encryption (spec §7) --------------------------------------
# REQUIRED — the app refuses to store credentials without a key. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: new key FIRST, old keys after, comma separated.
CREDENTIAL_ENCRYPTION_KEYS=change-me

# --- Trading policy -------------------------------------------------------
# Each is an open question in questions.md; both branches are built. Flipping
# a value changes behaviour with no code change — decide before connecting real
# accounts and re-read questions.md.
BALANCE_FRACTION=0.99
SLTP_BASIS=price
SLTP_REFERENCE=own_fill
SLTP_AMEND_STRATEGY=place_then_cancel
SLTP_FAILURE_POLICY=retry_then_close
SLTP_FAILURE_RETRIES=2
REJECT_SL_BEYOND_LIQUIDATION=true
FANOUT_TIMEOUT_SECONDS=10.0
MIN_LEVERAGE=1
MAX_LEVERAGE=10
# Spec §7 emergency-halt pin. false = the everyday panel switch works.
# true = a halt that cannot be cleared from the panel. Leave false to launch.
STOP_ALL=false

# --- Market data (spec §3) ------------------------------------------------
# Public price feeds for the chart and mark-to-market. No credentials.
# Set false for an air-gapped deployment.
MARKET_DATA_ENABLED=true
# Order matters, and applies only behind the connected exchanges (a venue you
# hold accounts on always quotes itself). Hyperliquid first.
MARKET_DATA_PROVIDERS=hyperliquid,binance,bybit
# Pin the feed to one venue, overriding both the connected-exchange preference
# and the fallbacks above. Under a pin there is no hand-off: this exchange
# answers or the panel says "no price feed". That is deliberate — a mark from
# a venue the admin is not trading is a different number, and sizing reads it.
# Hyperliquid is perpetuals only, so the spot chart has no feed under this pin.
# Clear it to restore connected-exchange-first behaviour.
MARKET_DATA_PIN=hyperliquid
# Outbound proxy for price calls. Empty uses the shell's HTTPS_PROXY/ALL_PROXY
# when httpx can speak it, else connects directly. Set it where the VPS can
# only reach the exchange through a proxy — a blocked feed is a 503 and a panel
# that cannot size an order, not a degraded chart.
MARKET_DATA_PROXY=

# --- History download -----------------------------------------------------
# How far the chart can pan back. Downloaded once in a background thread (no
# Celery worker in this deployment); the accounts page shows the progress.
# A year of 1m bars is ~525k rows per pair — dial PAIRS/DAYS down where disk
# or first-boot time matters more than intraday scrollback.
MARKET_DATA_AUTO_SYNC=true
BACKFILL_INTERVALS=1m,5m,15m,1h,4h,1d
BACKFILL_PAIRS=50
BACKFILL_DAYS=365

# --- CORS / CSRF ----------------------------------------------------------
# The panel proxies /api through its own origin, so no CORS traffic happens.
# But Django's HTTPS Origin check needs the real origin trusted for CSRF.
CORS_ALLOWED_ORIGINS=https://maxbot.cybercina.co.uk
