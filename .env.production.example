# PRODUCTION template. Copy to .env on the VPS and fill the `change-me` values:
#   cp .env.production.example .env
# .env is gitignored and must never be committed — this stack holds live,
# trade-enabled exchange credentials.
#
# Launch (see docs/deploy.md):
#   docker compose -f docker-compose.prod.yml up -d --build
#
# The domain must resolve to this server (A/AAAA record) before the stack
# starts: Caddy provisions the TLS certificate from Let's Encrypt at boot.

# --- Site -----------------------------------------------------------------
# Caddy terminates TLS for this domain. Everything public derives from it.
SITE_DOMAIN=maxbot.cybercina.co.uk

# --- Django ---------------------------------------------------------------
# Must be false in production. true disables every HTTPS hardening setting.
DJANGO_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
# The panel forwards the browser's Host as X-Forwarded-Host, so the public
# domain MUST be listed here or Django answers 400 DisallowedHost.
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1,maxbot.cybercina.co.uk
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
USE_SQLITE=false
POSTGRES_DB=walletmanager
POSTGRES_USER=walletmanager
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# --- Credential encryption (spec §7) --------------------------------------
# REQUIRED — the app refuses to store credentials without a key. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: new key FIRST, old keys after, comma separated.
CREDENTIAL_ENCRYPTION_KEYS=change-me

# --- Trading policy -------------------------------------------------------
# Each is an open question in questions.md; both branches are built. Flipping
# a value changes behaviour with no code change — decide before connecting real
# accounts and re-read questions.md.
BALANCE_FRACTION=0.99
SLTP_BASIS=price
SLTP_REFERENCE=own_fill
SLTP_AMEND_STRATEGY=place_then_cancel
SLTP_FAILURE_POLICY=retry_then_close
SLTP_FAILURE_RETRIES=2
REJECT_SL_BEYOND_LIQUIDATION=true
FANOUT_TIMEOUT_SECONDS=1.0
MIN_LEVERAGE=1
MAX_LEVERAGE=10
# Spec §7 emergency-halt pin. false = the everyday panel switch works.
# true = a halt that cannot be cleared from the panel. Leave false to launch.
STOP_ALL=false

# --- Market data (spec §3) ------------------------------------------------
# Public price feeds for the chart and mark-to-market. No credentials.
# Set false for an air-gapped deployment.
MARKET_DATA_ENABLED=true
# Order matters, and applies only behind the connected exchanges (a venue you
# hold accounts on always quotes itself). Hyperliquid first.
MARKET_DATA_PROVIDERS=hyperliquid,binance,bybit

# --- CORS / CSRF ----------------------------------------------------------
# The panel proxies /api through its own origin, so no CORS traffic happens.
# But Django's HTTPS Origin check needs the real origin trusted for CSRF.
CORS_ALLOWED_ORIGINS=https://maxbot.cybercina.co.uk
