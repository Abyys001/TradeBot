# VPS connection details — NEVER COMMITTED (see .gitignore).
#
# Consumed by deploy/remote-deploy.sh, which ssh's in and runs deploy/deploy.sh
# on the server. Nothing else reads this file, and nothing in the app does.
#
# Fill in VPS_USER and one of VPS_KEY / VPS_PASSWORD, then:
#   deploy/remote-deploy.sh

VPS_HOST=                        # the server's IP or hostname
VPS_PORT=22
VPS_USER=
VPS_PATH=~/walletmanager         # the checkout to deploy — nothing outside it is touched

# Auth: a key path is preferred. VPS_PASSWORD needs `sshpass` installed locally.
VPS_KEY=~/.ssh/id_ed25519
VPS_PASSWORD=

# Which compose file deploy/deploy.sh swaps, and the URL it probes before it
# will call the deploy finished.
DEPLOY_COMPOSE=docker-compose.prod.yml
DEPLOY_URL=https://maxbot.cybercina.co.uk
