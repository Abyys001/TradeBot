// Pine Script v5 — curated subset grammar (Lark, LALR + Indenter).
// Indentation-based blocks: the PineIndenter postlex emits _INDENT/_DEDENT.

start: _NL* statement*

?statement: simple_stmt
          | if_stmt
          | for_stmt

simple_stmt: _simple _NL
_simple: declaration
        | reassignment
        | assignment
        | expr

declaration: KW_VAR [TYPE] NAME "=" expr   -> state_declaration
reassignment: NAME ":=" expr               -> reassignment
assignment: [TYPE] NAME "=" expr           -> assignment

if_stmt: "if" expr suite elif_clause* else_clause?
elif_clause: "else" "if" expr suite
else_clause: "else" suite
for_stmt: "for" NAME "=" expr "to" expr suite

suite: _NL _INDENT statement+ _DEDENT

// --- Expressions (low -> high precedence) ---
?expr: ternary

?ternary: or_expr "?" ternary ":" ternary   -> ternary
        | or_expr

?or_expr: or_expr OR and_expr   -> binop
        | and_expr

?and_expr: and_expr AND not_expr   -> binop
         | not_expr

?not_expr: NOT not_expr   -> unary
         | comparison

?comparison: comparison COMP add_expr   -> binop
           | add_expr

?add_expr: add_expr ADD mul_expr   -> binop
         | mul_expr

?mul_expr: mul_expr MUL unary_minus   -> binop
         | unary_minus

?unary_minus: "-" unary_minus   -> neg
            | postfix

?postfix: postfix "[" expr "]"   -> history
        | atom

?atom: literal
     | member_call
     | call
     | member
     | NAME             -> identifier
     | "(" expr ")"

member_call: NAME "." NAME "(" [arguments] ")"
call: NAME "(" [arguments] ")"
member: NAME "." NAME

arguments: argument ("," argument)*
?argument: NAME "=" expr   -> kwarg
         | expr            -> posarg

?literal: FLOAT   -> float_lit
        | INT     -> int_lit
        | STRING  -> string_lit
        | "true"  -> true_lit
        | "false" -> false_lit
        | "na"    -> na_lit

// --- Terminals ---
KW_VAR.2: "varip" | "var"
TYPE.2: "float" | "int" | "bool" | "string" | "color"
OR: "or"
AND: "and"
NOT: "not"
COMP: "==" | "!=" | ">=" | "<=" | ">" | "<"
ADD: "+" | "-"
MUL: "*" | "/" | "%"

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
FLOAT: /(\d+\.\d*|\.\d+)([eE][+-]?\d+)?|\d+[eE][+-]?\d+/
INT: /\d+/
STRING: /"[^"]*"|'[^']*'/

COMMENT: /\/\/[^\n]*/
_NL: /(\r?\n[\t ]*)+/

%ignore COMMENT
%ignore /[ \t]+/
%declare _INDENT _DEDENT
