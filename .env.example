# Copy to .env and fill in. NEVER commit the real .env.

# Which settings module to load (config.settings.dev | config.settings.prod)
DJANGO_SETTINGS_MODULE=config.settings.dev

# Django core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL — docker-compose overrides DATABASE_URL for app services.
DATABASE_URL=postgres://tradebot:tradebot@localhost:5432/tradebot

# Redis — docker-compose overrides REDIS_URL for app services.
REDIS_URL=redis://localhost:6379/0

# Docker hot reload (1=watchfiles auto-restart, 0=production mode). Default in compose: 1
# RELOAD=1

# SPA CORS/CSRF (docker-compose overrides for container networking)
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# AES-256 master key for credential encryption.
# Generate with:  python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIAL_ENC_KEY=

# Hyperliquid (mainnet | testnet)
HL_NETWORK=testnet

# Dev-only: auto-created on first `docker compose up` when no users exist (DEBUG=True)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=admin
# DJANGO_SUPERUSER_EMAIL=admin@localhost
# HL_API_URL=
# HL_CANDLE_CHANNEL_PREFIX=hl:candles

# Hyperliquid runtime knobs
# HL_META_CACHE_TTL=300
# HL_WS_PING_INTERVAL=55
# HL_MIN_FREE_MARGIN_USD=50

# Local OHLCV history store for offline backtesting (default: <repo>/data/candles)
# CANDLE_DATA_DIR=

# Scheduled incremental history sync (public Hyperliquid API)
# HISTORY_SYNC_ASSETS=BTC,ETH,SOL,HYPE
# HISTORY_SYNC_TIMEFRAMES=1m,5m,15m,1h
# HISTORY_SYNC_NETWORK=mainnet
# HISTORY_SYNC_INTERVAL_SECONDS=3600
# HISTORY_DOWNLOAD_WORKERS=2
# HISTORY_FUNDING_COOLDOWN_SEC=1.5
