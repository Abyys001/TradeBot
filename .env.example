# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env && docker compose up -d --build

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# USE_SQLITE=true is the zero-setup dev path. Set false to use Postgres.
USE_SQLITE=true
POSTGRES_DB=walletmanager
POSTGRES_USER=walletmanager
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# --- Credential encryption (spec §7) --------------------------------------
# REQUIRED. Without it the app refuses to store credentials rather than
# writing them in plaintext. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: put the NEW key first, keep old keys after it, comma separated.
CREDENTIAL_ENCRYPTION_KEYS=

# --- Trading policy -------------------------------------------------------
# Each of these is an open question in questions.md. Both branches are built;
# flipping the value changes behaviour with no code change.

# Q12 / spec §5 — fraction of available balance committed as margin.
BALANCE_FRACTION=0.99

# Q5a — "price": SL% is a move in price. "margin": SL% is a loss of margin.
#       At 10x these differ by 10x. See /risk in the panel.
SLTP_BASIS=price

# Q5b, Q5c — "own_fill": each account measures from its own fill price.
#            "admin_price": every account gets the admin's absolute price.
SLTP_REFERENCE=own_fill

# Q5d — "place_then_cancel" (brief double protection, safe with reduce-only)
#       "cancel_then_place" (brief unprotected gap — not recommended)
#       "native_amend" where the exchange supports true amend
SLTP_AMEND_STRATEGY=place_then_cancel

# Q5e — entry filled but SL/TP failed:
#       "retry_then_close"  retry, then market-close (default, safest)
#       "retry_then_notify" retry, then leave the position UNPROTECTED
#       "close_immediately" no retries
SLTP_FAILURE_POLICY=retry_then_close
SLTP_FAILURE_RETRIES=2

# Refuse a stop at or beyond the liquidation price (it could never trigger).
REJECT_SL_BEYOND_LIQUIDATION=true

# Spec §4 — hard per-account deadline for a fan-out leg, in seconds.
FANOUT_TIMEOUT_SECONDS=1.0

# Spec §3 — leverage range offered by the UI.
MIN_LEVERAGE=1
MAX_LEVERAGE=10

# Spec §7 — emergency halt. Stops NEW order routing platform-wide.
# Closing open positions still works while this is on, by design.
#
# This is the *pin*: true here means the halt cannot be cleared from the panel.
# The everyday switch is in the panel's top bar (stored in the database), so
# leave this false unless you want a halt that survives a browser session.
STOP_ALL=false

# --- Market data (spec §3) ------------------------------------------------
# Public price feeds for the chart and for marking positions to market. No
# credentials are used and no account context is involved. Providers are tried
# in order; if none answers, the panel is served labelled synthetic candles
# ("sample prices") rather than a broken chart — and a synthetic price is never
# used to size a real order. Set false for an air-gapped deployment.
MARKET_DATA_ENABLED=true
MARKET_DATA_PROVIDERS=binance,bybit

# --- Frontend -------------------------------------------------------------
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
NUXT_PUBLIC_WS_BASE=ws://localhost:8000/ws
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
