# Copy to .env and fill in. NEVER commit the real .env.
# Generate secrets:
#   SECRET_KEY:           python -c "import secrets;print(secrets.token_urlsafe(50))"
#   CREDENTIAL_ENC_KEY:   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# Which settings module to load (config.settings.dev | config.settings.prod)
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Django core ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# --- PostgreSQL (docker-compose overrides DATABASE_URL for app services) ---
POSTGRES_USER=tradebot
POSTGRES_PASSWORD=tradebot
POSTGRES_DB=tradebot
DATABASE_URL=postgres://tradebot:tradebot@localhost:5432/tradebot

# --- Redis (docker-compose overrides REDIS_URL for app services) ---
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- Docker hot reload (1=watchfiles auto-restart, 0=production mode) ---
# RELOAD=1

# --- SPA CORS/CSRF (docker-compose overrides for container networking) ---
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- AES-256 master key for credential encryption ---
CREDENTIAL_ENC_KEY=

# --- Exchange: Hyperliquid (mainnet | testnet) ---
HL_NETWORK=testnet
# HL_API_URL=
# HL_CANDLE_CHANNEL_PREFIX=hl:candles
# HL_META_CACHE_TTL=300
# HL_API_TIMEOUT=30
# HL_WS_PING_INTERVAL=55
# HL_MIN_FREE_MARGIN_USD=50

# --- Exchange: Tabdeal (copy-trading exchange) ---
# TABDEAL_API_BASE_URL=https://api1.tabdeal.org
# TABDEAL_RECV_WINDOW_MS=5000
# TABDEAL_API_TIMEOUT=30

# --- Telegram alerts ---
TELEGRAM_ALERT_ENABLED=False

# --- History sync ---
# HISTORY_SYNC_ASSETS=BTC,ETH,SOL,HYPE
# HISTORY_SYNC_TIMEFRAMES=1m,5m,15m,1h
# HISTORY_SYNC_NETWORK=mainnet
# HISTORY_SYNC_INTERVAL_SECONDS=3600
# HISTORY_DOWNLOAD_WORKERS=2
# HISTORY_FUNDING_COOLDOWN_SEC=1.5

# --- Dev-only: auto-created on first `docker compose up` when no users exist (DEBUG=True) ---
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=admin
# DJANGO_SUPERUSER_EMAIL=admin@localhost
# CREATE_DEV_SUPERUSER=False
